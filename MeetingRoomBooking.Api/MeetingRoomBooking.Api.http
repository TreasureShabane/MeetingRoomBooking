@MeetingRoomBooking.Api_HostAddress = http://localhost:5108
@roomId = 11111111-1111-1111-1111-111111111111
@bookingId = REPLACE_WITH_ID_FROM_CREATE_RESPONSE

### List rooms
GET {{MeetingRoomBooking.Api_HostAddress}}/api/rooms
Accept: application/json

### Get a room
GET {{MeetingRoomBooking.Api_HostAddress}}/api/rooms/{{roomId}}
Accept: application/json

### Get a room that does not exist
GET {{MeetingRoomBooking.Api_HostAddress}}/api/rooms/99999999-9999-9999-9999-999999999999
Accept: application/json

### List all bookings
GET {{MeetingRoomBooking.Api_HostAddress}}/api/bookings
Accept: application/json

### List bookings for a room
GET {{MeetingRoomBooking.Api_HostAddress}}/api/bookings?roomId={{roomId}}
Accept: application/json

### Create a booking
POST {{MeetingRoomBooking.Api_HostAddress}}/api/bookings
Content-Type: application/json

{
  "roomId": "{{roomId}}",
  "title": "Design review",
  "start": "2030-10-25T09:00:00Z",
  "end": "2030-10-25T10:00:00Z"
}

### Get a booking (replace bookingId with the ID returned by create)
GET {{MeetingRoomBooking.Api_HostAddress}}/api/bookings/{{bookingId}}
Accept: application/json

### Update a booking
PUT {{MeetingRoomBooking.Api_HostAddress}}/api/bookings/{{bookingId}}
Content-Type: application/json

{
  "roomId": "{{roomId}}",
  "title": "Design review - updated",
  "start": "2030-10-25T10:00:00Z",
  "end": "2030-10-25T11:00:00Z"
}

### Cancel a booking
DELETE {{MeetingRoomBooking.Api_HostAddress}}/api/bookings/{{bookingId}}
